{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime (seconds)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "process_uptime_seconds{application=\"java-enterprise-portfolio\"}", "refId": "A", "legendFormat": "uptime" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 60 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Products Total",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "products_total", "refId": "A", "legendFormat": "total" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Circuit Breaker (eventPublisher)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "resilience4j_circuitbreaker_state{name=\"eventPublisher\"} == 1", "refId": "A", "legendFormat": "{{state}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": [
            { "type": "value", "options": { "closed": { "text": "CLOSED", "color": "green" }, "open": { "text": "OPEN", "color": "red" }, "half_open": { "text": "HALF_OPEN", "color": "orange" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM Heap Used",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\",application=\"java-enterprise-portfolio\"})", "refId": "A", "legendFormat": "heap" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 268435456 }, { "color": "red", "value": 402653184 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"java-enterprise-portfolio\"}[1m]))", "refId": "A", "legendFormat": "{{uri}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Product Operations Rate (op/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum by (operation) (rate(products_operations_total[1m]))", "refId": "A", "legendFormat": "{{operation}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 30, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM Heap (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\",application=\"java-enterprise-portfolio\"}", "refId": "A", "legendFormat": "used-{{id}}" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\",application=\"java-enterprise-portfolio\"}", "refId": "B", "legendFormat": "max-{{id}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM Threads",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "jvm_threads_live_threads{application=\"java-enterprise-portfolio\"}", "refId": "A", "legendFormat": "live" },
        { "expr": "jvm_threads_daemon_threads{application=\"java-enterprise-portfolio\"}", "refId": "B", "legendFormat": "daemon" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HikariCP Connections",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"java-enterprise-portfolio\"}", "refId": "A", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{application=\"java-enterprise-portfolio\"}", "refId": "B", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{application=\"java-enterprise-portfolio\"}", "refId": "C", "legendFormat": "pending" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["java", "spring-boot", "jvm", "enterprise"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Java Enterprise Portfolio - JVM & Application",
  "uid": "jvm-application",
  "version": 1,
  "weekStart": ""
}
